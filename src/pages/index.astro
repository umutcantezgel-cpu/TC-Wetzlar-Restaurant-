---
/**
 * Homepage - TC Wetzlar Restaurant
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';

// SEO Data from contract
const seoData = {
  title: 'TC Wetzlar Restaurant – Gehobene Gastronomie im Herzen von Wetzlar',
  description:
    'Erleben Sie kulinarische Exzellenz im TC Wetzlar Restaurant. Internationale und mediterrane Küche in elegantem Ambiente. Jetzt Tisch reservieren!',
  canonical: 'https://tc-wetzlar-restaurant.de/',
  ogImage: '/assets/img/og-home.jpg',
};

// Structured Data
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'TC Wetzlar Restaurant',
  image: 'https://tc-wetzlar-restaurant.de/assets/img/restaurant-exterior.jpg',
  description: 'Gehobene Gastronomie im Herzen von Wetzlar mit internationaler und mediterraner Küche',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Musterstraße 123',
    addressLocality: 'Wetzlar',
    addressRegion: 'Hessen',
    postalCode: '35576',
    addressCountry: 'DE',
  },
  telephone: '+49-6441-123456',
  email: 'info@tc-wetzlar-restaurant.de',
  url: 'https://tc-wetzlar-restaurant.de',
  servesCuisine: ['International', 'Mediterran', 'Deutsche Küche'],
  priceRange: '€€€',
  acceptsReservations: 'True',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '17:30',
      closes: '23:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday', 'Sunday'],
      opens: '12:00',
      closes: '23:00',
    },
  ],
};

const features = [
  {
    title: 'Erlesene Küche',
    description: 'Internationale und mediterrane Spezialitäten, zubereitet mit frischen, regionalen Zutaten.',
    icon: '🍽️',
  },
  {
    title: 'Edle Getränke',
    description: 'Ausgewählte Weine aus renommierten Anbaugebieten und erstklassige Spirituosen.',
    icon: '🍷',
  },
  {
    title: 'Elegantes Ambiente',
    description: 'Stilvolle Räumlichkeiten für romantische Abende, Geschäftsessen und besondere Anlässe.',
    icon: '✨',
    featured: true,
  },
];
---

<BaseLayout {...seoData} structuredData={structuredData}>
  <Header />

  <main id="main-content">
    <!-- Hero Section -->
    <Hero
      heading="Willkommen im TC Wetzlar Restaurant"
      subheading="Kulinarische Exzellenz im Herzen von Wetzlar"
      image="/assets/img/hero-placeholder.jpg"
      imageAlt="Elegantes Restaurant-Interieur"
      ctaPrimary={{ text: 'Jetzt reservieren', href: '/reservierung' }}
      ctaSecondary={{ text: 'Speisekarte ansehen', href: '/speisekarte' }}
      variant="full"
    />

    <!-- Features Section -->
    <section class="section features" aria-labelledby="features-heading">
      <div class="container">
        <h2 id="features-heading" class="section__heading" data-reveal-up>Unser Versprechen</h2>

        <div class="features__grid" data-reveal-stagger>
          {features.map((feature) => (
            <Card
              title={feature.title}
              description={feature.description}
              icon={feature.icon}
              variant="glass"
              featured={feature.featured}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="section cta-section" aria-labelledby="cta-heading">
      <div class="container">
        <div class="cta-box glass-card" data-reveal-up>
          <h2 id="cta-heading" class="cta-box__heading">Reservieren Sie Ihren Tisch</h2>
          <p class="cta-box__text">
            Erleben Sie unvergessliche kulinarische Momente in unserem Restaurant.
            Wir freuen uns auf Ihren Besuch!
          </p>
          <div class="cta-box__actions">
            <Button href="/reservierung" variant="primary" size="lg">
              Zur Reservierung
            </Button>
            <Button href="/kontakt" variant="tertiary" size="lg">
              Kontakt aufnehmen
            </Button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .section {
    padding-top: var(--layout-section-spacing);
    padding-bottom: var(--layout-section-spacing);
  }

  .section__heading {
    font-family: var(--font-family-display);
    font-size: var(--primitive-font-size-4xl);
    text-align: center;
    margin-bottom: var(--spacing-2xl);
    color: var(--color-text-primary);
  }

  /* Features Section */
  .features {
    background: var(--gradient-mesh), var(--color-surface);
  }

  .features__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--spacing-xl);
    max-width: 1200px;
    margin: 0 auto;
  }

  /* CTA Section */
  .cta-section {
    background-color: var(--color-background);
  }

  .cta-box {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    padding: var(--spacing-2xl);
  }

  .cta-box__heading {
    font-family: var(--font-family-display);
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--spacing-md);
    color: var(--color-text-primary);
  }

  .cta-box__text {
    font-size: var(--primitive-font-size-lg);
    line-height: var(--primitive-line-height-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-xl);
  }

  .cta-box__actions {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Responsive */
  @media (max-width: 767px) {
    .features__grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    .cta-box {
      padding: var(--spacing-xl);
    }

    .cta-box__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<script src="../scripts/scroll-reveal.ts"></script>
