---
/**
 * Hero Component
 * WCAG 2.2 AA Compliant
 */
import Button from './Button.astro';

export interface Props {
  heading: string;
  subheading?: string;
  image?: string;
  imageAlt?: string;
  ctaPrimary?: {
    text: string;
    href: string;
  };
  ctaSecondary?: {
    text: string;
    href: string;
  };
  variant?: 'full' | 'half';
}

const {
  heading,
  subheading,
  image,
  imageAlt = '',
  ctaPrimary,
  ctaSecondary,
  variant = 'full',
} = Astro.props;
---

<section class:list={['hero', `hero--${variant}`]} aria-label="Hero">
  {image && (
    <div class="hero__image-wrapper">
      <img
        src={image}
        alt={imageAlt}
        class="hero__image"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="1080"
      />
      <div class="hero__overlay" aria-hidden="true"></div>
    </div>
  )}

  <div class="hero__content container">
    <div class="hero__text">
      <h1 class="hero__heading">{heading}</h1>
      {subheading && <p class="hero__subheading">{subheading}</p>}

      {(ctaPrimary || ctaSecondary) && (
        <div class="hero__actions">
          {ctaPrimary && (
            <Button href={ctaPrimary.href} variant="primary" size="lg">
              {ctaPrimary.text}
            </Button>
          )}
          {ctaSecondary && (
            <Button href={ctaSecondary.href} variant="tertiary" size="lg">
              {ctaSecondary.text}
            </Button>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 60vh;
    overflow: hidden;
  }

  .hero--full {
    min-height: 80vh;
  }

  .hero__image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--gradient-overlay-gold);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: var(--spacing-3xl);
    padding-bottom: var(--spacing-3xl);
  }

  .hero__text {
    max-width: 800px;
    background: var(--glass-bg-light);
    border: 1px solid var(--glass-border-light);
    border-radius: var(--primitive-radius-2xl);
    padding: var(--spacing-xl);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow-lg);
  }

  .hero__heading {
    font-family: var(--font-family-display);
    font-weight: var(--primitive-font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-md);
    text-shadow: 0 2px 8px rgba(255, 255, 255, 0.5);
    letter-spacing: -0.02em;
  }

  .hero__subheading {
    font-size: var(--primitive-font-size-xl);
    line-height: var(--primitive-line-height-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-xl);
  }

  .hero__actions {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  /* No image variant */
  .hero:not(:has(.hero__image-wrapper)) {
    background: var(--gradient-mesh), var(--color-surface);
  }

  .hero:not(:has(.hero__image-wrapper)) .hero__text {
    background: var(--glass-bg-light-subtle);
  }

  .hero:not(:has(.hero__image-wrapper)) .hero__heading {
    text-shadow: none;
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 50vh;
    }

    .hero--full {
      min-height: 60vh;
    }

    .hero__actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
